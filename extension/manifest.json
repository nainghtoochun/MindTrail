{
  "manifest_version": 3,
  "name": "MindTrail",
  "version": "1.2.0",
  "description": "Record, save, and replay your browsing research.",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MindTrail",
    "default_popup": "popup.html"
  }
}
